# Copia este archivo a .env (make env) y ajusta valores. .env NO se sube al repo.

APP_ENV=dev
TZ=America/Lima

# Secretos internos (cámbialos en producción)
INTERNAL_SECRET=change-me
QR_SIGNING_SECRET=change-me

# Solo desarrollo: superusuario del panel /_/ y contraseña de los usuarios de prueba (data/seed/users.dev.json)
PB_SUPERUSER_EMAIL=super@qhatu.test
PB_SUPERUSER_PASSWORD=Qhatu2026Super!
SEED_DEV_PASSWORD=Qhatu2026!

# OTP simulado: con valor, se acepta siempre este código (vacío en producción)
OTP_FIXED_CODE=123456

# Google OAuth2 (opcional). Si están vacíos se configura a mano en /_/ > users > OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs internas de los microservicios (red de docker compose)
MS_AUTH_TRUST_URL=http://ms-auth-trust:3001
MS_PAYMENTS_QR_URL=http://ms-payments-qr:3002
MS_LOGISTICS_URL=http://ms-logistics-dispatch:3003
MS_RATINGS_URL=http://ms-ratings-aggregator:3004
